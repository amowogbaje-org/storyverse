VITE_API_URL=http://localhost:8000/api/v1

# Google Sign-In (Google Identity Services). Use the same OAuth Client ID
# configured as GOOGLE_CLIENT_ID in the backend .env. Create it in Google
# Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# ("Web application"), and add http://localhost:5173 to
# "Authorized JavaScript origins". If left blank, the Google button is
# simply hidden and email/password sign-in still works.
VITE_GOOGLE_CLIENT_ID=
