VITE_API_URL=http://localhost:8000/api/v1

# The public-facing site URL - used for canonical links, Open Graph tags, and
# generating sitemap.xml/robots.txt at build time (see scripts/generate-seo-files.mjs).
# Not the API URL above - this is the domain people actually visit.
VITE_SITE_URL=http://localhost:5173

# Google Sign-In (Google Identity Services). Use the same OAuth Client ID
# configured as GOOGLE_CLIENT_ID in the backend .env. Create it in Google
# Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# ("Web application"), and add http://localhost:5173 to
# "Authorized JavaScript origins". If left blank, the Google button is
# simply hidden and email/password sign-in still works.
VITE_GOOGLE_CLIENT_ID=

# Web push notifications. Same value as VAPID_PUBLIC_KEY in backend/.env
# (generate both with the tinker command documented there). Leave blank and
# the push-notification toggle on the profile page just won't show up.
VITE_VAPID_PUBLIC_KEY=
