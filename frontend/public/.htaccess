# Client-side routing (React Router) fallback for Apache/cPanel hosting.
# Copied into dist/ automatically by Vite on every `npm run build`.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Compression - most cPanel hosts have mod_deflate available even where
# mod_brotli isn't; this alone typically cuts JS/CSS/HTML transfer size by
# 60-80%. Not applied to images (already compressed formats - re-gzipping
# them wastes CPU for no size benefit).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Caching. Vite fingerprints every JS/CSS filename with a content hash
# (main.a1b2c3.js) specifically so it's safe to cache those forever - a new
# deploy produces new filenames rather than changing what's behind an old
# one. index.html (and the SW/manifest/SEO files) must NOT be cached, or
# a redeploy wouldn't be visible until the cache expires.
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpe?g|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
