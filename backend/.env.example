# Local Docker dev (compose.yaml). For cPanel/bare-metal, copy
# .env.cpanel.example instead - different DB driver and no Redis/Meilisearch.

APP_NAME=Storyverse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ANALYTICS_SUMMARY_EMAILS=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=storyverse
DB_USERNAME=storyverse
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=storyverse_master_key

JWT_SECRET=
JWT_TTL=60

# Payment gateways - leave blank locally; checkout calls will fail until set.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# AI search - leave blank locally; /search/ai will fall back to native search until set.
OPENAI_API_KEY=

# Laravel AI SDK (composer require laravel/ai) - config/ai.php reads these
# directly. Only GEMINI_API_KEY is required to start; OPENAI_API_KEY above is
# picked up automatically too, so switching AI_SEARCH_PROVIDER back to openai
# later needs no other change here.
GEMINI_API_KEY=

# Which provider App\Ai\Agents\StorySearchAgent uses (see config/services.php
# ai_search.provider) - lowercase Laravel\Ai\Enums\Lab case name, e.g. gemini,
# openai, anthropic, groq, xai.
AI_SEARCH_PROVIDER=gemini

# Episode styling agent (adds bold/italics/scene-breaks to raw episode text -
# see App\Ai\Agents\EpisodeStylingAgent and the app:style-episodes command,
# scheduled every 15 minutes). Same Lab case names as AI_SEARCH_PROVIDER
# above; ollama and deepseek both already have driver config in config/ai.php,
# so switching to either is just this var plus that provider's key/URL below.
EPISODE_STYLING_PROVIDER=gemini
DEEPSEEK_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_API_KEY=

# CraftProfessor series-export integration (storyverse-api-docs.md) - max
# episodes' full text sent per /api/stories/{slug}/json call; see
# CraftProfessorExportController.
CRAFTPROFESSOR_CONTENT_BATCH_SIZE=40

# Google Sign-In (Google Identity Services). Create an OAuth 2.0 Client ID
# ("Web application") in Google Cloud Console and add both your frontend
# origin and http://localhost:5173 to "Authorized JavaScript origins".
# This same value is also used by the frontend as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# SMS (not wired up to any code path yet - reserved for future OTP/notifications)
SMS_TERMII_API_KEY=

# Badges keep unlocking/notifying either way - this only gates actually
# granting a badge's reward (bonus premium days etc). Flip on when ready.
BADGE_REWARDS_ENABLED=false
BADGE_TASTEMAKER_EARLY_VIEWS=50
BADGE_TASTEMAKER_TRENDING_VIEWS=1000

# Web push - generate once with:
#   php artisan tinker --execute="print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
# VAPID_PUBLIC_KEY also needs to be copied into frontend/.env as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@storyverse.local

# Story publishing/access thresholds - see config/access.php
MIN_EPISODES_TO_PUBLISH=60
GUEST_EPISODE_LIMIT=2
REGISTERED_PREMIUM_EPISODE_LIMIT=14

# Monthly author payouts - see config/payouts.php. Real money movement stays
# off by default; payouts are generated but need manual admin action to send.
PAYOUTS_AUTO_SEND_ENABLED=false
PAYOUTS_MINIMUM_USD=5
PAYOUTS_MINIMUM_GBP=5
PAYOUTS_MINIMUM_NGN=2000

# Performance monitoring - works today with zero extra packages (see
# AppServiceProvider::logSlowQueries and App\Http\Middleware\LogSlowRequests).
# Logs to storage/logs/performance.log, separate from the main app log.
# Lower these once you've seen a week of real traffic and know your baseline.
SLOW_QUERY_THRESHOLD_MS=200
SLOW_REQUEST_THRESHOLD_MS=1000

# Laravel Telescope - deeper, UI-based request/query/exception inspector.
# NOT installed yet (see README's "Setting up Telescope" section for the
# 4 commands to run) - these just get read once it is. Telescope's own
# per-request overhead means it should stay off in production unless you're
# actively investigating something, hence defaulting to false here rather
# than Telescope's own package default (which is "on everywhere").
TELESCOPE_ENABLED=false
